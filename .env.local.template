# Krossover Studio — copy to .env.local and fill in.
# Everything runs on fallbacks until a value is set, so fill in as you go.
# See GO-LIVE.md for what each stage unlocks.

# --- Stage 1: Database (required to save) ---
DATABASE_URL=postgresql://user:pass@host.neon.tech/krossover?sslmode=require

# --- Stage 2: Asset storage (required for uploads + print files) ---
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# --- Stage 3: Admin security (required before exposing admin) ---
ADMIN_API_KEY=

# --- Stage 4: AI mockup (optional) ---
MOCKUP_PROVIDER=gemini
GEMINI_API_KEY=
# OPENAI_API_KEY=
# FAL_KEY=

# --- Stage 5: Background removal (optional) ---
BG_PROVIDER=removebg
REMOVEBG_API_KEY=

# --- Stage 6: Upload moderation (recommended) ---
MODERATION_URL=
MODERATION_KEY=

# --- Stage 7: Production CMYK (needs ghostscript on host) ---
ENABLE_CMYK=0

# --- Editor -> API base (same-origin in the app) ---
NEXT_PUBLIC_STUDIO_API=/api

# --- Krossover website product feed (dynamic inventory) ---
# Unset = uses the bundled snapshot (src/data/catalog.json, 917 products).
KROSSOVER_PRODUCTS_URL=https://kross-over.net/api/products
KROSSOVER_API_KEY=
CATALOG_REFRESH_MS=900000
