# Krossover Studio — environment
# Copy to .env.local and fill in. Nothing here is required to run the demo.

# Where the editor + admin call the API (defaults to same-origin /api in dev)
NEXT_PUBLIC_API_BASE=/api

# Background removal provider (optional — the editor has a built-in white-key fallback)
# BG_REMOVAL_PROVIDER=imgly   # or: removebg | cloudinary
# REMOVEBG_API_KEY=

# AI product-mockup provider (for /api/mockup). Pick one and set its key.
# MOCKUP_PROVIDER=gemini      # gemini | openai | fal
# GEMINI_API_KEY=             # Nano Banana / Gemini 2.5 Flash Image
# OPENAI_API_KEY=             # gpt-image-1
# FAL_KEY=                    # fal-ai/nano-banana/edit

# Tell the embedded editor where the API lives (so Generate AI mockup + quote work)
# NEXT_PUBLIC_STUDIO_API=/api

# Database (Postgres — Neon / Supabase / RDS). Unset = runs on seed data, no DB.
# DATABASE_URL=postgresql://user:pass@host:5432/krossover

# Admin auth for template/pricing writes (unset = open in dev)
# ADMIN_API_KEY=

# Asset storage (S3 / Cloudflare R2 / DO Spaces). Unset = local /public/uploads
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_URL=

# Background removal (unset = sharp white-key fallback)
# BG_PROVIDER=removebg        # removebg | imgly
# REMOVEBG_API_KEY=

# Upload moderation (unset = pass-through). Wire Sightengine / Rekognition / Hive.
# MODERATION_URL=
# MODERATION_KEY=

# Production print PDF in CMYK (needs ghostscript `gs` on the host)
# ENABLE_CMYK=1
